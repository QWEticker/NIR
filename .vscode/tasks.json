{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "cmake",
            "command": "configure",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake Build",
            "type": "cmake",
            "command": "build",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run All Tests",
            "type": "shell",
            "command": "ctest --output-on-failure -j4",
            "options": { "cwd": "${workspaceFolder}/build" },
            "dependsOn": "CMake Build",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Run Nominal Experiment",
            "type": "shell",
            "command": "./cvqkd_sim --config ../experiments/nominal.json",
            "options": { "cwd": "${workspaceFolder}/build" },
            "dependsOn": "CMake Build",
            "problemMatcher": []
        }
    ]
}