flowchart LR
    B["Принятый сигнал b"] --> BS["Делитель 50/50"]
    LO["Локальный осциллятор<br/>(опорный луч)"] --> BS
    BS --> HX["Гомодин X<br/>X = √η·Re(b) + ν_x"]
    BS --> HP["Гомодин P<br/>P = √η·Im(b) + ν_p"]
    ETA["Кв. эффективность η"] -.-> HX
    ETA -.-> HP
    VEL["Электронный шум v_el<br/>σ_det² = (1+v_el)/η"] -.-> HX
    VEL -.-> HP
    HX --> OUT["Квадратуры (X, P)<br/>χ_het = (2−η+2v_el)/η"]
    HP --> OUT
