flowchart TB
    subgraph VEC["Векторизация (Eigen)"]
        V1["квадратуры X, P как VectorXd длины N"]
        V2["канал: b = √T·a + n<br/>над всем вектором сразу"]
        V3["атаки: m.X *= s, clip(...)<br/>без поэлементных ООП-вызовов"]
        V1 --> V2 --> V3
    end
    subgraph AN["Аналитика вместо стохастики"]
        A1["χ_BE по замкнутым формулам<br/>(симплектические с.з., O(1))"]
        A2["нет диагонализации матриц<br/>нет Монте-Карло для Евы"]
        A1 --> A2
    end
    subgraph MEM["Память и потоковость"]
        P1["обработка по точкам sweep"]
        P2["пик памяти ~ размер выборки N"]
        P3["метрики -> строка CSV, выборка освобождается"]
        P1 --> P2 --> P3
    end
    subgraph DET["Детерминизм"]
        D1["std::mt19937_64 с фикс. seed"]
        D2["раздельные потоки ГПСЧ:<br/>seed^0xC0FFEE (канал), seed^0xDEADBEEF (детектор)"]
        D3["побитово воспроизводимые серии"]
        D1 --> D2 --> D3
    end
    VEC --> SPEED["прогон N~10⁶ за секунды;<br/>дешёвый sweep и перебор параметров"]
    AN --> SPEED
    MEM --> SPEED
    DET --> REPRO["воспроизводимость и проверяемость"]
